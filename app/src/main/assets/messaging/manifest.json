{
  "manifest_version": 2,
  "name": "my-tv-bridge",
  "version": "1.0",
  "description": "My TV 0 native bridge for GeckoView.",
  "browser_specific_settings": {
    "gecko": {
      "id": "mytv-bridge@lizongying"
    }
  },
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    }
  ],
  "permissions": [
    "nativeMessaging",
    "nativeMessagingFromContent",
    "geckoViewAddons",
    "webRequest",
    "<all_urls>"
  ]
}